# Copier vers .env et adapter (ne jamais committer .env)
# cp .env.example .env

# --- Django ---
# Local : DJANGO_DEBUG=true  |  Production : DJANGO_DEBUG=false (défaut si absent)
DJANGO_DEBUG=true
# Obligatoire (pas de fallback). Générer :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,votre-domaine.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://votre-domaine.com,http://localhost:8000
# Ignoré si DJANGO_DEBUG=true ; en prod (DEBUG=false) laisser true derrière HTTPS
DJANGO_SECURE_SSL_REDIRECT=true
# Rate limiting (login, reset, écritures API). false uniquement pour tests locaux.
DJANGO_RATELIMIT_ENABLE=true
# Cache Redis (optionnel). Si défini → rate limit partagé entre workers Gunicorn.
# Local : docker run -d -p 6379:6379 --name xaliss-redis redis:7-alpine
# REDIS_URL=redis://127.0.0.1:6379/1

# --- PostgreSQL ---
POSTGRES_DB=xaliss
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Abonnements SaaS ---
# Vide = prélaunch. Au lancement officiel, date ISO (ex. 2026-09-01).
XALISS_LANCEMENT_LE=
# Durée de l'essai Pro gratuit (jours), défaut 90 ≈ 3 mois
XALISS_DUREE_ESSAI_JOURS=90
# Accès conservé pendant N jours après periode_fin si statut en_retard
XALISS_JOURS_GRACE_RETARD=3
# E-mails autorisés sur /backoffice/ (virgules si plusieurs)
BACKOFFICE_ALLOWED_EMAILS=imamelhadji.msk@gmail.com
# Destinataire des messages du formulaire Contact (landing)
LANDING_CONTACT_EMAIL=contact@xaliss.com
# Téléphone affiché dans le footer (ex. +221771234567)
LANDING_CONTACT_PHONE=
# WhatsApp sans + ni espaces (ex. 221771234567) — bouton footer
LANDING_WHATSAPP=
# Horaires affichés dans le footer
LANDING_HORAIRES=Lun – Ven · 9h – 18h

# --- E-mail (SMTP) : requis pour confirmation compte, mdp oublié, contact landing ---
# Exemple SSL (port 465) :
# EMAIL_HOST=smtp.exemple.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=true
# EMAIL_USE_TLS=false
# EMAIL_HOST_USER=no-reply@xaliss.com
# EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=Xaliss <no-reply@xaliss.com>
# En local sans SMTP : les mails s'affichent dans la console (DJANGO_DEBUG=true).

# --- Google OAuth (application xaliss) ---
# Remplacer par les identifiants de VOTRE projet Google Cloud (ne pas committer les vrais secrets).
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-client-secret
